<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>New Contact Message</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <div
      style="
        max-width: 650px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
      "
    >
      <!-- Header -->
      <div
        style="background-color: #111827; padding: 28px 32px; color: #ffffff"
      >
        <h1 style="margin: 0; font-size: 24px; font-weight: 700">
          New Contact Message
        </h1>

        <p style="margin: 8px 0 0; font-size: 14px; color: #d1d5db">
          Someone has contacted you through your portfolio.
        </p>
      </div>

      <!-- Content -->
      <div style="padding: 32px">
        <div
          style="
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
          "
        >
          <p style="margin: 0 0 14px">
            <strong>Name:</strong>
            <%= name %>
          </p>

          <p style="margin: 0 0 14px">
            <strong>Email:</strong>
            <%= email %>
          </p>

          <p style="margin: 0">
            <strong>Subject:</strong>
            <%= subject %>
          </p>
        </div>

        <div style="margin-top: 24px">
          <h2 style="margin: 0 0 12px; font-size: 18px; color: #111827">
            Message
          </h2>

          <div
            style="
              background-color: #f9fafb;
              border-left: 4px solid #111827;
              padding: 18px;
              border-radius: 6px;
              color: #374151;
              line-height: 1.7;
              white-space: pre-line;
            "
          >
            <%= message %>
          </div>
        </div>

        <div
          style="
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
            font-size: 13px;
            color: #6b7280;
          "
        >
          <p style="margin: 0">
            This message was submitted through your portfolio contact form.
          </p>

          <p style="margin: 8px 0 0">
            Reply directly to this email to respond to
            <strong><%= name %></strong>.
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 20px 32px;
          background-color: #f9fafb;
          text-align: center;
          border-top: 1px solid #e5e7eb;
        "
      >
        <p style="margin: 0; font-size: 12px; color: #9ca3af">
          Portfolio Contact Notification
        </p>
      </div>
    </div>
  </body>
</html>
